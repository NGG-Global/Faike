# Reality Defender, read only by server code (src/lib/rd/client.ts).
# Copy to .env.local for local development and set real values in Vercel's
# environment settings. Never commit a real key, and never prefix these
# variables with NEXT_PUBLIC_: that would publish them in the browser bundle.

# API key from https://app.realitydefender.ai/settings/manage-api-keys
REALITY_DEFENDER_API_KEY=

# Documented production API base URL (no trailing slash needed).
REALITY_DEFENDER_API_BASE_URL=https://api.prd.realitydefender.xyz
